includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - database
        - routes

    level: 6

    # Models declare casts via the casts() method (Laravel 11+ style), not the
    # legacy $casts property, so Larastan needs to parse that method's AST.
    parseModelCastsMethod: true
